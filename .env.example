# Server-only Supabase Transaction pooler URL (port 6543).
# Use a login inheriting weekly_report_app; percent-encode its password.
DATABASE_URL=
# For `npm run db:migrate`: admin direct connection or Session pooler (5432).
# Needed locally for migrations only, not on Vercel.
DIRECT_URL=
# Optional custom CA override; the public Supabase Root 2021 CA is bundled.
# Use a PEM certificate with literal \n between lines.
DATABASE_CA_CERT=
# Obtain a Web application client ID from Google Auth Platform.
GOOGLE_CLIENT_ID=
# First administrator must sign in with this Gmail / Google Workspace address.
ADMIN_EMAIL=
# Exact origin, no trailing slash. Register it as a Google authorized JS origin.
APP_ORIGIN=http://localhost:3001

